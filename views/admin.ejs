            </div>

        </div>

    </div>

</section>


    <!-- YENİ RANDEVU MODALI -->
    <div class="modal fade" id="appointmentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content admin-modal">

                <div class="modal-header">
                    <div>
                        <span class="section-mini-title">RANDEVU YÖNETİMİ</span>
                        <h2 class="modal-title">Yeni Randevu</h2>
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                    </button>
                </div>

                <form id="appointmentForm">

                    <div class="modal-body">

                        <div class="row g-3">

                            <!-- Ad Soyad -->
                            <div class="col-md-6">
                                <label class="form-label">Ad Soyad</label>
                                <input type="text" name="name" class="form-control" required placeholder="Müşteri adı">
                            </div>

                            <!-- Telefon -->
                            <div class="col-md-6">
                                <label class="form-label">Telefon</label>
                                <input type="tel" name="phone" class="form-control" required
                                    placeholder="05XX XXX XX XX">
                            </div>

                            <!-- Araç -->
                            <div class="col-md-6">
                                <label class="form-label">Araç</label>
                                <input type="text" name="vehicle" class="form-control" required placeholder="BMW 320i">
                            </div>

                            <!-- Hizmet -->
                            <div class="col-md-6">
                                <label class="form-label">Hizmet</label>

                                <select name="service" class="form-select" required>

                                    <option value="">Hizmet seçin</option>

                                    <% services .filter(service=> service.status === "active")
                                        .forEach(service => { %>

                                        <option value="<%= service.name %>">
                                            <%= service.name %>
                                        </option>

                                        <% }) %>

                                </select>
                            </div>

                            <!-- Tarih -->
                            <div class="col-md-6">
                                <label class="form-label">Tarih</label>

                                <input type="date" name="date" class="form-control" required>
                            </div>

                            <!-- Saat -->
                            <div class="col-md-6">
                                <label class="form-label">Saat</label>

                                <select name="time" class="form-select" required>

                                    <option value="">Saat seçin</option>
                                    <option value="09:00">09:00</option>
                                    <option value="10:00">10:00</option>
                                    <option value="11:00">11:00</option>
                                    <option value="12:00">12:00</option>
                                    <option value="13:00">13:00</option>
                                    <option value="14:00">14:00</option>
                                    <option value="15:00">15:00</option>
                                    <option value="16:00">16:00</option>
                                    <option value="17:00">17:00</option>
                                    <option value="18:00">18:00</option>

                                </select>
                            </div>

                            <!-- Not -->
                            <div class="col-12">
                                <label class="form-label">Not</label>

                                <textarea name="message" class="form-control" rows="3"
                                    placeholder="Randevu notu..."></textarea>
                            </div>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                            Vazgeç
                        </button>

                        <button type="submit" class="btn btn-lime rounded-pill px-4">
                            Randevuyu Oluştur
                        </button>

                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- HİZMET EKLE / DÜZENLE MODALI -->
    <div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content admin-modal">

                <div class="modal-header">
                    <div>
                        <span class="section-mini-title">HİZMET YÖNETİMİ</span>
                        <h2 class="modal-title" id="serviceModalTitle">
                            Hizmet Ekle
                        </h2>
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
                    </button>
                </div>

                <form id="serviceForm">

                    <div class="modal-body">

                        <!-- Hizmet adı -->
                        <div class="mb-3">
                            <label class="form-label">Hizmet adı</label>

                            <input id="serviceName" name="name" type="text" class="form-control" required
                                placeholder="Örn. Seramik Kaplama">
                        </div>


                        <!-- Açıklama -->
                        <div class="mb-3">
                            <label class="form-label">Açıklama</label>

                            <textarea id="serviceDescription" name="description" class="form-control" rows="3" required
                                placeholder="Hizmet açıklaması"></textarea>
                        </div>


                        <!-- Fiyat + Durum -->
                        <div class="row g-3">

                            <div class="col-6">
                                <label class="form-label">Fiyat</label>

                                <input id="servicePrice" name="price" type="number" class="form-control" min="0"
                                    required placeholder="2500">
                            </div>


                            <div class="col-6">
                                <label class="form-label">Durum</label>

                                <select id="serviceStatus" name="status" class="form-select">

                                    <option value="active">Yayında</option>
                                    <option value="inactive">Pasif</option>

                                </select>
                            </div>

                        </div>

                    </div>


                    <div class="modal-footer">

                        <!-- SADECE DÜZENLEMEDE GÖRÜNECEK -->
                        <button type="button" class="btn btn-outline-danger rounded-pill px-4 d-none"
                            id="serviceDeleteBtn">

                            <i class="bi bi-trash me-1"></i>
                            Sil

                        </button>


                        <div class="ms-auto d-flex gap-2">

                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">

                                Vazgeç

                            </button>


                            <button type="submit" class="btn btn-lime rounded-pill px-4">

                                Kaydet

                            </button>

                        </div>

                    </div>

                </form>

            </div>
        </div>
    </div>

    <!-- LOGOUT KUTUSU -->
    <div class="logout-popover" id="logoutPopover">
        <i class="bi bi-box-arrow-right"></i>
        <span>Çıkış işlemi backend bağlantısında yapılacak.</span>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js?v=20261030-appointment-status-sync"></script>
</body>

</html>