    ></span>
</button>

                <div class="dropdown">
                    <button class="admin-profile admin-profile-btn" type="button" data-bs-toggle="dropdown"
                        aria-expanded="false">
                        <div class="avatar">DG</div>
                        <div class="d-none d-sm-block text-start">
                            <strong>Detail Garage</strong>
                            <small>Yönetici</small>
                        </div>
                        <i class="bi bi-chevron-down small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end admin-dropdown shadow-sm">
                        <li><button class="dropdown-item logout-item" type="button" id="logoutBtn">
