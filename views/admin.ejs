                            <span>Görselin mevcut boyutu ve görünümü korunur.</span>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <label for="businessLogoFile" class="form-label">Yeni logo seç</label>
                        <input
                            type="file"
                            class="form-control"
                            id="businessLogoFile"
                            accept="image/png,image/jpeg,image/webp"
                        >
                        <small class="text-secondary d-block mt-2">
                            PNG, JPG veya WEBP · En fazla 5 MB. Logo yüklendiğinde site başlığındaki logo ve sekme simgesi güncellenir.
                        </small>
                        <button type="button" class="btn btn-lime rounded-pill px-4 mt-3" id="uploadBusinessLogoBtn">
                            <i class="bi bi-upload me-1"></i>
                            Logoyu Güncelle
                        </button>
                    </div>
                </div>
            </div>
        </div>



        <!-- SOL TARAF -->
        <div class="col-xl-7">

            <div class="panel-card h-100">

                <div class="panel-header mb-4">

                    <div>
                        <span class="section-mini-title">
                            FOOTER BİLGİLERİ
                        </span>

                        <h2>
                            İşletme bilgileri
                        </h2>
                    </div>

                </div>


                <div class="row g-3">

                    <!-- İŞLETME ADI -->
                    <div class="col-md-6">

                        <label class="form-label">
                            İşletme adı
                        </label>

                        <input
                            type="text"
                            id="businessName"
                            class="form-control"
                            value="<%= businessSettings.businessName %>">

                    </div>


                    <!-- TELEFON -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Telefon
                        </label>

                        <input
                            type="text"
                            id="businessPhone"
                            class="form-control"
                            value="<%= businessSettings.phone %>">

                    </div>


                    <!-- E-POSTA -->
                    <div class="col-md-6">

                        <label class="form-label">
                            E-posta
                        </label>

                        <input
                            type="email"
                            id="businessEmail"
                            class="form-control"
                            value="<%= businessSettings.email %>">

                    </div>


                    <!-- KONUM -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Şehir
                        </label>

                        <input
                            type="text"
                            id="businessLocation"
                            class="form-control"
                            value="<%= businessSettings.location %>">

                    </div>


                    <!-- FOOTER AÇIKLAMASI -->
                    <div class="col-12">

                        <label class="form-label">
                            Footer açıklaması
                        </label>

                        <textarea
                            id="footerDescription"
                            class="form-control"
                            rows="3"><%= businessSettings.footerDescription %></textarea>

                    </div>


                    <!-- COPYRIGHT -->
                    <div class="col-12">

                        <label class="form-label">
                            Alt bilgi / copyright
                        </label>

                        <input
                            type="text"
                            id="businessCopyright"
                            class="form-control"
                            value="<%= businessSettings.copyright %>">

                    </div>
                    <div class="panel-card mb-4">
    <div class="panel-header mb-4">
        <div>
            <span class="section-mini-title">RANDEVU SİSTEMİ</span>
            <h2>Randevu durumu</h2>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between">
        <div>
            <strong>Randevuları kabul et</strong>
            <div class="text-secondary small">
                Kapalı olduğunda müşteriler randevu oluşturamaz.
            </div>
        </div>

        <div class="form-check form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                id="appointmentsOpen"
                <%= businessSettings.appointmentsOpen ? "checked" : "" %>
            >
        </div>
    </div>
</div>

                </div>

            </div>

        </div>


        <!-- SAĞ TARAF -->
        <div class="col-xl-5">

            <div class="panel-card mb-4">

                <div class="panel-header mb-4">

                    <div>

                        <span class="section-mini-title">
                            SOSYAL MEDYA & LİNKLER
                        </span>

                        <h2>
                            Footer bağlantıları
                        </h2>

                    </div>

                </div>


                <div class="settings-link-list">


                    <!-- INSTAGRAM -->
                    <div class="settings-link-row">

                        <div class="link-label">

                            <i class="bi bi-instagram"></i>

                            <span>
                                Instagram
                            </span>

                        </div>

                        <input
                            type="url"
                            id="instagramUrl"
                            class="form-control"
                            value="<%= businessSettings.instagramUrl %>">

                    </div>


                    <!-- TIKTOK -->
                    <div class="settings-link-row">

                        <div class="link-label">

                            <i class="bi bi-tiktok"></i>

                            <span>
                                TikTok
                            </span>

                        </div>

                        <input
                            type="url"
                            id="tiktokUrl"
                            class="form-control"
                            value="<%= businessSettings.tiktokUrl %>">

                    </div>


                    <!-- WHATSAPP -->
                    <div class="settings-link-row">

                        <div class="link-label">

                            <i class="bi bi-whatsapp"></i>

                            <span>
                                WhatsApp
                            </span>

                        </div>

                        <input
                            type="url"
                            id="whatsappUrl"
                            class="form-control"
                            value="<%= businessSettings.whatsappUrl %>">

                    </div>


                    <!-- GOOGLE MAPS -->
                    <div class="settings-link-row">

                        <div class="link-label">

                            <i class="bi bi-geo-alt-fill"></i>

                            <span>
                                Google Maps
                            </span>

                        </div>

                        <input
                            type="url"
                            id="businessMapUrl"
                            class="form-control"
                            value="<%= businessSettings.mapUrl %>"
                            placeholder="https://www.google.com/maps/embed?pb=...">

                        <small class="text-secondary mt-1">

                            Google Maps'teki iframe kodunun
                            sadece <strong>src</strong> adresini yapıştırın.

                        </small>

                    </div>


                </div>

            </div>


            <!-- FOOTER MENÜSÜ -->
            <div class="panel-card">

                <div class="panel-header mb-3">

                    <div>

                        <span class="section-mini-title">
                            FOOTER MENÜSÜ
                        </span>

                        <h2>
                            Menü bağlantıları
                        </h2>

                    </div>

                </div>


                <div class="row g-2">

                    <div class="col-6">

                        <input
                            type="text"
                            class="form-control"
                            value="Hakkımızda">

                    </div>

                    <div class="col-6">

                        <input
                            type="text"
                            class="form-control"
                            value="#about">

                    </div>


                    <div class="col-6">

                        <input
                            type="text"
                            class="form-control"
                            value="Hizmetler">

                    </div>

                    <div class="col-6">

                        <input
                            type="text"
                            class="form-control"
                            value="#services">

                    </div>


                    <div class="col-6">

                        <input
                            type="text"
                            class="form-control"
                            value="Galeri">

                    </div>

