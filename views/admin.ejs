        <!-- CONTENT -->
        <main class="content-area">

            <!-- DASHBOARD -->
            <section id="dashboard" class="panel-section active-section">

                <%
    // Türkiye saatine göre tarih ve ay
    const today = new Date().toLocaleDateString("sv-SE", {
        timeZone: "Europe/Istanbul"
    });
    const currentMonth = today.slice(0, 7);

    // Bugünkü ve bu ayki randevular
    const todayAppointments = appointments.filter(
        appointment => appointment.date === today
    );
    const monthlyAppointments = appointments.filter(
        appointment => appointment.date && appointment.date.startsWith(currentMonth)
    );

    // Bekleyen randevular
    const pendingAppointments = appointments.filter(
        appointment => appointment.status === "pending"
    );

    // Bu ay tamamlanan işlemler
    const monthlyCompleted = monthlyAppointments.filter(
        appointment => appointment.status === "completed"
    );

    // Tamamlanan işlemlerin hizmet dağılımı
    const serviceCounts = {};
    monthlyCompleted.forEach(appointment => {
        serviceCounts[appointment.service] =
            (serviceCounts[appointment.service] || 0) + 1;
    });

    // Hizmet isimleri ve güncel fiyatları veritabanındaki hizmetlerden alınır
    const serviceList = services.map(service => service.name);
    monthlyCompleted.forEach(appointment => {
        if (!serviceList.includes(appointment.service)) {
            serviceList.push(appointment.service);
        }
    });



    const maxServiceCount = Math.max(
        ...serviceList.map(service => serviceCounts[service] || 0),
        1
    );

    // Tahmini ciro: bu ay tamamlanan işlemler x hizmetin mevcut fiyatı
    const monthlyRevenue = monthlyCompleted.reduce((total, appointment) => {
        const matchingService = services.find(service => service.name === appointment.service);
        return total + (matchingService ? Number(matchingService.price) || 0 : 0);
    }, 0);

    const formatCurrency = amount => new Intl.NumberFormat("tr-TR", {
        style: "currency",
        currency: "TRY",
        maximumFractionDigits: 0
    }).format(amount);

    // Son 4 randevu
    const recentAppointments = appointments.slice(0, 4);

    // Türkçe ay etiketi
    const formattedMonth = new Date(
        `${currentMonth}-01T00:00:00`
    ).toLocaleDateString("tr-TR", {
        month: "long",
        year: "numeric",
        timeZone: "Europe/Istanbul"
    });
%>


                    <!-- İSTATİSTİKLER -->
                    <div class="row g-4 mb-4">

                        <!-- BUGÜNKÜ RANDEVU -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="stat-card">

                                <div class="stat-icon icon-lime">
                                    <i class="bi bi-calendar2-check"></i>
                                </div>

                                <div class="stat-meta">

                                    <span>Bugünkü Randevu</span>

                                    <strong>
                                        <%= todayAppointments.length %>
                                    </strong>

                                    <small>
                                        Bugün için planlanan randevu
                                    </small>

                                </div>

                            </div>
                        </div>


                        <!-- BEKLEYEN -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="stat-card">

                                <div class="stat-icon icon-blue">
                                    <i class="bi bi-clock-history"></i>
                                </div>

                                <div class="stat-meta">

                                    <span>Bekleyen</span>

                                    <strong>
                                        <%= pendingAppointments.length %>
                                    </strong>

                                    <small>
                                        Onay bekleyen randevu
                                    </small>

                                </div>

                            </div>
                        </div>


                        <!-- BU AY TAMAMLANAN -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="stat-card">

                                <div class="stat-icon icon-purple">
                                    <i class="bi bi-car-front-fill"></i>
                                </div>

                                <div class="stat-meta">

                                    <span>Bu Ay İşlem</span>

                                    <strong>
                                        <%= monthlyCompleted.length %>
                                    </strong>

                                    <small>
                                        Bu ay tamamlanan işlem
                                    </small>

                                </div>

                            </div>
                        </div>

                        <!-- BUGÜNKÜ ZİYARET -->
<div class="col-12 col-sm-6 col-xl-3">

    <div class="stat-card">

        <div class="stat-icon icon-orange">
            <i class="bi bi-people-fill"></i>
        </div>

        <div class="stat-meta">

            <span>Bugünkü Ziyaret</span>

            <strong>
                <%= todayVisitors %>
            </strong>

            <small>
                Bugün siteyi ziyaret edenler
            </small>

        </div>

    </div>

</div>
                        

                    </div>


                    <!-- ALT KISIM -->
                    <div class="row g-4">


                        <!-- SON RANDEVULAR -->
                        <div class="col-xl-8">

                            <div class="panel-card h-100">

                                <div class="panel-header">

                                    <div>

                                        <span class="section-mini-title">
                                            RANDEVU AKIŞI
                                        </span>

                                        <h2>
                                            Son randevular
                                        </h2>

                                    </div>

                                    <a href="#appointments" class="panel-link">
                                        Tümünü gör
                                        <i class="bi bi-arrow-right"></i>
                                    </a>

                                </div>


                                <div class="table-responsive">

                                    <table class="table align-middle data-table mb-0">

                                        <thead>

                                            <tr>
                                                <th>Müşteri</th>
                                                <th>Araç</th>
                                                <th>Hizmet</th>
                                                <th>Tarih</th>
                                                <th>Durum</th>
                                            </tr>

                                        </thead>


                                        <tbody>

                                            <% if (recentAppointments.length===0) { %>

                                                <tr>

                                                    <td colspan="5" class="text-center py-5 text-secondary">
                                                        Henüz randevu bulunmuyor.
                                                    </td>

                                                </tr>

                                                <% } else { %>


                                                    <% recentAppointments.forEach(appointment=> { %>

                                                        <tr>

                                                            <!-- MÜŞTERİ -->
                                                            <td>

                                                                <strong>
                                                                    <%= appointment.name %>
                                                                </strong>

                                                                <span class="sub-text">
                                                                    <%= appointment.phone %>
                                                                </span>

                                                            </td>


                                                            <!-- ARAÇ -->
                                                            <td>
                                                                <%= appointment.vehicle %>
                                                            </td>


                                                            <!-- HİZMET -->
                                                            <td>
                                                                <%= appointment.service %>
                                                            </td>


                                                            <!-- TARİH -->
                                                            <td>

                                                                <%= new Date( `${appointment.date}T00:00:00`
                                                                    ).toLocaleDateString("tr-TR", { day: "2-digit" ,
                                                                    month: "short" , timeZone: "Europe/Istanbul" }) %>

                                                                    ·

                                                                    <%= appointment.time %>

                                                            </td>


                                                            <!-- DURUM -->
                                                            <td>

                                                                <% if (appointment.status==="pending" ) { %>

                                                                    <span class="badge-soft badge-warning">
                                                                        Bekliyor
                                                                    </span>

                                                                    <% } else if (appointment.status==="confirmed" ) {
                                                                        %>

                                                                        <span class="badge-soft badge-success">
                                                                            Onaylandı
                                                                        </span>

                                                                        <% } else if (appointment.status==="rejected" )
                                                                            { %>

                                                                            <span class="badge-soft badge-danger">
                                                                                Reddedildi
                                                                            </span>

                                                                            <% } else if
                                                                                (appointment.status==="completed" ) { %>

                                                                                <span class="badge-soft badge-success">
                                                                                    Tamamlandı
                                                                                </span>

                                                                                <% } %>

                                                            </td>

                                                        </tr>

                                                        <% }) %>

                                                            <% } %>

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        </div>


                        <!-- AYLIK İŞLEM ÖZETİ -->
                        <div class="col-xl-4">
                            <div class="panel-card h-100">
                                <div class="panel-header">
                                    <div>
                                        <span class="section-mini-title">AYLIK ÖZET</span>
                                        <h2>İşlem özeti</h2>
                                    </div>
                                    <span class="date-chip"><%= formattedMonth %></span>
                                </div>

                                <div class="progress-list">
                                    <% if (monthlyCompleted.length === 0) { %>
                                        <div class="text-center py-4 text-secondary small">
                                            Bu ay henüz tamamlanmış işlem yok.
                                        </div>
                                    <% } else { %>
                                        <% serviceList.forEach(service => {
                                            const count = serviceCounts[service] || 0;
                                            const percentage = Math.round((count / maxServiceCount) * 100);
                                        %>
                                            <div class="progress-item">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span><%= service %></span>
                                                    <strong><%= count %> araç</strong>
                                                </div>
                                                <div class="progress-track">
                                                    <span style="<%= `width: ${percentage}%;` %>"></span>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                </div>

                                <!-- AYLIK TAHMİNİ CİRO -->
                                <div class="daily-note mt-4">
                                    <i class="bi bi-cash-stack"></i>
                                    <div>
                                        <strong>Aylık tahmini ciro</strong>
                                        <span><%= formatCurrency(monthlyRevenue) %></span>
                                    </div>
                                </div>

                                <!-- AYLIK İŞLEM SAYILARI -->
                                <div class="daily-note mt-3">
                                    <i class="bi bi-calendar-check-fill"></i>
                                    <div>
                                        <strong>Aylık yapılan işlemler</strong>
                                        <span><%= monthlyCompleted.length %> tamamlanan işlem · <%= monthlyAppointments.length %> toplam randevu</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

            </section>

    



            <!-- Yeni özellik: mevcut randevu ekranından bağımsız takvim -->
            <section id="appointment-calendar" class="panel-section">
                <div class="section-toolbar calendar-toolbar">
                    <div><span class="section-mini-title">PLANLAMA</span><h2>Randevu Takvimi</h2><p class="text-secondary mb-0">Randevuları tarih ve durumlarına göre görüntüle.</p></div>
                    <div class="calendar-view-switch btn-group" role="group" aria-label="Takvim görünümü">
                        <button type="button" class="btn btn-outline-secondary active" data-calendar-view="month">Ay</button>
                        <button type="button" class="btn btn-outline-secondary" data-calendar-view="week">Hafta</button>
                    </div>
                </div>
                <div class="panel-card appointment-calendar-card">
                    <div class="appointment-calendar-controls">
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-light calendar-nav-btn" id="calendarPrev" aria-label="Önceki dönem"><i class="bi bi-chevron-left"></i></button>
                            <button type="button" class="btn btn-light calendar-nav-btn" id="calendarNext" aria-label="Sonraki dönem"><i class="bi bi-chevron-right"></i></button>
                            <button type="button" class="btn btn-outline-secondary" id="calendarToday">Bugün</button>
                        </div>
                        <h3 id="calendarHeading" class="calendar-heading mb-0" aria-live="polite"></h3>
                    </div>
                    <div class="calendar-legend" aria-label="Randevu durumları">
                        <span><i class="calendar-legend-dot is-pending"></i>Bekleyen</span><span><i class="calendar-legend-dot is-rejected"></i>Reddedilen</span><span><i class="calendar-legend-dot is-confirmed"></i>Onaylanan</span><span><i class="calendar-legend-dot is-completed"></i>Tamamlanan</span>
                    </div>
                    <div id="appointmentCalendar" class="appointment-calendar" aria-live="polite"><div class="calendar-loading">Takvim yükleniyor...</div></div>
                    <p class="calendar-footnote mb-0"><i class="bi bi-arrow-repeat me-1"></i>Randevular otomatik olarak güncellenir.</p>
                </div>
                <div class="panel-card calendar-detail-card mt-4">
                    <div class="panel-header"><div><span class="section-mini-title">SEÇİLİ GÜN</span><h2 id="calendarDayHeading">Günün randevuları</h2></div></div>
                    <div id="calendarDayAppointments" class="calendar-day-appointments"><p class="text-secondary mb-0">Takvimden bir gün seç.</p></div>
                </div>
            </section>

            <!-- APPOINTMENTS -->
            <section id="appointments" class="panel-section">

                <!-- BAŞLIK -->
                <div class="section-toolbar">

                    <div>
                        <span class="section-mini-title">
                            RANDEVU YÖNETİMİ
                        </span>

                        <h2>
                            Randevular
                        </h2>
                    </div>

                    <button class="btn btn-lime rounded-pill px-4" data-bs-toggle="modal"
                        data-bs-target="#appointmentModal">
                        <i class="bi bi-plus-lg me-1"></i>
                        Yeni Randevu
                    </button>

                </div>


                <!-- FİLTRELER -->
                <div class="filter-card panel-card mb-4">

                    <div class="row g-3 align-items-end">

                        <!-- ARAMA -->
                        <div class="col-md-5">

                            <label class="form-label">
                                Ara
                            </label>

                            <div class="input-icon">

                                <i class="bi bi-search"></i>

                                <input type="text" id="appointmentSearch" class="form-control"
                                    placeholder="Müşteri, telefon veya araç...">

                            </div>

                        </div>


                        <!-- DURUM -->
                        <div class="col-md-3">

                            <label class="form-label">
                                Durum
                            </label>

                            <select id="appointmentStatusFilter" class="form-select">

                                <option value="">
                                    Tüm durumlar
                                </option>

                                <option value="pending">
                                    Bekliyor
                                </option>

                                <option value="confirmed">
                                    Onaylandı
                                </option>

                                <option value="completed">
                                    Tamamlandı
                                </option>

                                <option value="rejected">
                                    Reddedildi
                                </option>

                            </select>

                        </div>


                        <!-- TARİH -->
                        <div class="col-md-3">

                            <label class="form-label">
                                Tarih
                            </label>

                            <input type="date" id="appointmentDateFilter" class="form-control">

                        </div>


                        <!-- TEMİZLE -->
                        <div class="col-md-1">

                            <button type="button" id="appointmentFilterReset" class="filter-reset w-100"
                                title="Filtreleri temizle">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>

                        </div>

                    </div>

                </div>


               <!-- RANDEVU TABLOSU -->
<div class="panel-card">

    <div class="table-responsive">

        <table class="table align-middle data-table mb-0">

            <thead>

                <tr>

                    <th>
                        Müşteri
                    </th>

                    <th>
                        Araç
                    </th>

                    <th>
                        Hizmet
                    </th>

                    <th>
                        Tarih
                    </th>

                    <th>
                        Not
                    </th>

                    <th>
                        Durum
                    </th>

                    <th class="text-end">
                        İşlem
                    </th>

                </tr>

            </thead>


            <tbody>

                <% if (appointments.length === 0) { %>

                    <tr>

                        <td
                            colspan="7"
                            class="text-center py-5 text-secondary"
                        >

                            <i
                                class="bi bi-calendar-x d-block fs-3 mb-2"
                            ></i>

                            Henüz randevu bulunmuyor.

                        </td>

                    </tr>

                <% } else { %>


                    <% appointments.forEach(appointment => { %>

                        <tr
                            data-appointment-id="<%= appointment._id %>"
                            data-status="<%= appointment.status %>"
                            data-date="<%= appointment.date %>"
                        >

                            <!-- MÜŞTERİ -->
                            <td>

                                <strong>
                                    <%= appointment.name %>
                                </strong>

                                <span class="sub-text">
                                    <%= appointment.phone %>
                                </span>

                            </td>


                            <!-- ARAÇ -->
                            <td>

                                <%= appointment.vehicle %>

                            </td>


                            <!-- HİZMET -->
                            <td>

                                <%= appointment.service %>

                            </td>


                            <!-- TARİH -->
                            <td>

                                <%= new Date(
                                    `${appointment.date}T00:00:00`
                                ).toLocaleDateString(
                                    "tr-TR",
                                    {
                                        day: "2-digit",
                                        month: "short"
                                    }
                                ) %>

                                ·

                                <%= appointment.time %>

                            </td>


                            <!-- NOT -->
                            <td>

                                <%= appointment.message || "—" %>

                            </td>


                            <!-- DURUM -->
                            <td>

                                <% if (appointment.status === "pending") { %>

                                    <span class="badge-soft badge-warning">
                                        Bekliyor
                                    </span>

                                <% } %>


                                <% if (appointment.status === "confirmed") { %>

                                    <span class="badge-soft badge-success">
                                        Onaylandı
                                    </span>

                                <% } %>


                                <% if (appointment.status === "rejected") { %>

                                    <span class="badge-soft badge-danger">
                                        Reddedildi
                                    </span>

                                <% } %>


                                <% if (appointment.status === "completed") { %>

                                    <span class="badge-soft badge-success">
                                        Tamamlandı
                                    </span>

                                <% } %>

                            </td>


                            <!-- İŞLEMLER -->
                            <td class="text-end">

                                <div class="d-inline-flex align-items-center gap-2">

                                    <!-- 3 NOKTA -->
                                    <div class="dropdown dropup">

                                        <button
                                            class="table-action"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            title="İşlemler"
                                        >
                                            <i class="bi bi-three-dots"></i>
                                        </button>


                                        <ul
                                            class="dropdown-menu dropdown-menu-end appointment-menu shadow-sm"
                                        >

                                            <!-- ONAYLA -->
                                            <li>

                                                <button
                                                    type="button"
                                                    class="dropdown-item appointment-action"
                                                    data-action="confirmed"
                                                    data-id="<%= appointment._id %>"
                                                >

                                                    <i
                                                        class="bi bi-check2-circle text-success me-2"
                                                    ></i>

                                                    Onayla

                                                </button>

                                            </li>


                                            <!-- REDDET -->
                                            <li>

                                                <button
                                                    type="button"
                                                    class="dropdown-item appointment-action"
                                                    data-action="rejected"
                                                    data-id="<%= appointment._id %>"
                                                >

                                                    <i
                                                        class="bi bi-x-circle text-danger me-2"
                                                    ></i>

                                                    Reddet

                                                </button>

                                            </li>


                                            <!-- TAMAMLANDI -->
                                            <li>

                                                <button
                                                    type="button"
                                                    class="dropdown-item appointment-action"
                                                    data-action="completed"
                                                    data-id="<%= appointment._id %>"
                                                >

                                                    <i
                                                        class="bi bi-check-lg me-2"
                                                    ></i>

                                                    Tamamlandı

                                                </button>

                                            </li>

                                        </ul>

                                    </div>


                                    <!-- SİL BUTONU -->
                                    <button
                                        type="button"
                                        class="table-action text-danger appointment-delete-btn"
                                        data-id="<%= appointment._id %>"
                                        title="Randevuyu sil"
                                        aria-label="Randevuyu sil"
                                    >

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>

                            </td>

                        </tr>

                    <% }) %>

                <% } %>

